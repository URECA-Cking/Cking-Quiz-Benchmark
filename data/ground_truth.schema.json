{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video fact candidate or human-reviewed fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["videoId", "factId", "fact", "evidenceType", "evidence", "sourceUrl", "reviewStatus"],
  "properties": {
    "videoId": {"type": "string", "minLength": 1},
    "factId": {"type": "string", "minLength": 1},
    "fact": {"type": "string", "minLength": 1},
    "evidenceType": {"enum": ["video_observation", "authorized_transcript"]},
    "evidence": {"type": "string", "minLength": 1},
    "sourceUrl": {"type": "string", "format": "uri"},
    "reviewStatus": {"enum": ["pending_human", "approved", "rejected"]},
    "timestampStartSeconds": {"type": "number", "minimum": 0},
    "timestampEndSeconds": {"type": "number", "minimum": 0},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date-time"}
  },
  "if": {"properties": {"reviewStatus": {"const": "approved"}}, "required": ["reviewStatus"]},
  "then": {"required": ["reviewer", "reviewedAt"]}
}
