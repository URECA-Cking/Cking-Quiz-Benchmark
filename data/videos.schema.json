{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pilot video metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["videoId", "youtubeUrl", "title", "sourcePageUrl", "rightsNote", "accessCheckedAt"],
  "anyOf": [{"required": ["captionUrl"]}, {"required": ["transcriptPageUrl"]}],
  "properties": {
    "videoId": {"type": "string", "minLength": 1},
    "youtubeUrl": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 1},
    "durationSeconds": {"type": "integer", "minimum": 1, "description": "영상 자체의 재생 시간을 별도로 확인한 경우에만 기록"},
    "captionEndSeconds": {"type": "number", "minimum": 0, "description": "공식 자막의 마지막 시각이며 영상 길이와 동일하다고 가정하지 않음"},
    "sourcePageUrl": {"type": "string", "format": "uri"},
    "captionUrl": {"type": "string", "format": "uri"},
    "transcriptPageUrl": {"type": "string", "format": "uri", "description": "자막이 페이지에 직접 제공되는 경우"},
    "rightsNote": {"type": "string", "minLength": 1, "description": "공개 접근 및 평가·메타데이터 공유 가능 여부를 확인한 근거"},
    "accessCheckedAt": {"type": "string", "format": "date-time"},
    "transcriptAvailability": {"enum": ["available", "unavailable", "unknown"]},
    "transcriptAccessNote": {"type": "string"}
  }
}
